{
  "name": "packforge-expedition-prototype",
  "version": "0.24.0",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "node --test",
    "serve": "node scripts/serve.mjs",
    "serve:lan": "node scripts/serve.mjs --lan",
    "mobile:prepare": "node scripts/prepare-mobile.mjs",
    "android:sync": "pnpm mobile:prepare && node node_modules/@capacitor/cli/bin/capacitor sync android",
    "android:build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-android.ps1"
  },
  "dependencies": {
    "@capacitor/android": "8.4.2",
    "@capacitor/core": "8.4.2"
  },
  "devDependencies": {
    "@capacitor/cli": "8.4.2"
  }
}
